{% extends 'base.html.twig' %}

{% block title %}Avis — {{ current_establishment.name }}{% endblock %}
{% block page_title %}Tous les avis{% endblock %}

{% block body %}
	<div class="rr-inbox-head">
		<div>
			<h1 class="rr-page-title">{{ current_establishment.name }}</h1>
			<p class="rr-page-sub">Tous les avis Google de l'établissement, du plus récent au plus ancien.</p>
		</div>
	</div>

	<form class="rr-inbox-toolbar" data-role="filters" data-tone="{{ current_establishment.replyTone }}" onsubmit="return false">
		<label class="d-flex align-items-center gap-2">
			<span class="rr-review-meta">Note</span>
			<select class="rr-select" id="filter-rating">
				<option value="">Toutes</option>
				<option value="5">5 étoiles</option>
				<option value="4">4 étoiles</option>
				<option value="3">3 étoiles</option>
				<option value="2">2 étoiles</option>
				<option value="1">1 étoile</option>
			</select>
		</label>
		<label class="d-flex align-items-center gap-2">
			<span class="rr-review-meta">Période</span>
			<select class="rr-select" id="filter-period">
				<option value="all">Depuis le début</option>
				<option value="7j">7 derniers jours</option>
				<option value="30j">30 derniers jours</option>
				<option value="90j">90 derniers jours</option>
			</select>
		</label>
		<label class="d-flex align-items-center gap-2">
			<span class="rr-review-meta">Réponse</span>
			<select class="rr-select" id="filter-status">
				<option value="">Tous les avis</option>
				<option value="unanswered" {{ app.request.query.get('status') == 'unanswered' ? 'selected' }}>Sans réponse</option>
				<option value="answered">Avec réponse</option>
			</select>
		</label>
	</form>

	<div id="reviews-container" aria-live="polite">
		<p class="rr-empty">Chargement des avis…</p>
	</div>

	<nav class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4" id="pagination-container" aria-label="Pagination" hidden></nav>
{% endblock %}

{% block javascripts %}
	<script src="{{ asset('js/review-reply.js') }}"></script>
	<script src="{{ asset('js/reviews.js') }}"></script>
{% endblock %}
