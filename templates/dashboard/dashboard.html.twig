{% extends 'base.html.twig' %}

{% block title %}Tableau de bord — {{ current_establishment.name ?? 'MonAvisPro' }}{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block topbar_actions %}
	{% if current_establishment %}
		<button type="button" class="rr-btn rr-btn-secondary" id="sync-btn" data-action="sync">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 11-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
			<span>Synchroniser</span>
		</button>
	{% endif %}
{% endblock %}

{% block body %}
	{% if establishments is empty %}
		<section class="rr-welcome" aria-labelledby="welcome-title">
			<p class="rr-welcome-kicker">Compte créé</p>
			<h1 class="rr-welcome-title" id="welcome-title">Reliez votre fiche Google pour voir vos avis</h1>
			<p class="rr-welcome-lead">Une minute, une seule fois. Ensuite, chaque nouvel avis arrive ici avec une réponse déjà prête.</p>

			<div class="rr-card rr-card-lg rr-welcome-card">
				<ol class="rr-welcome-steps">
					<li>
						<span class="rr-welcome-step rr-welcome-step-current" aria-hidden="true">1</span>
						<div><strong>Connectez-vous avec le compte Google de votre fiche</strong><span>Celui que vous utilisez pour gérer votre établissement sur Google Maps.</span></div>
					</li>
					<li>
						<span class="rr-welcome-step" aria-hidden="true">2</span>
						<div><strong>Choisissez votre établissement</strong><span>Si vous en avez plusieurs, vous pourrez ajouter les autres ensuite.</span></div>
					</li>
					<li>
						<span class="rr-welcome-step" aria-hidden="true">3</span>
						<div><strong>Vos avis arrivent</strong><span>Les plus urgents en premier, dans « À traiter ».</span></div>
					</li>
				</ol>
				<a href="{{ path('google_business_connect') }}" class="rr-btn rr-btn-primary rr-btn-lg rr-welcome-cta">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
					Connecter ma fiche Google
				</a>
			</div>

			<p class="rr-welcome-foot">
				<span>MonAvisPro ne publie rien sans votre accord.</span>
				<a href="{{ path('establishment_new') }}" class="rr-link">Pas de fiche Google ? Ajouter mon commerce à la main</a>
			</p>
		</section>
	{% else %}
		<script type="application/json" id="curve-data">{{ stats.curve|default([])|json_encode|raw }}</script>

		<div class="rr-inbox-head">
			<div>
				<h1 class="rr-page-title">{{ current_establishment.name }}</h1>
				<p class="rr-page-sub">
					{{ current_establishment.address }}
					{% if current_establishment.lastSyncAt %} · avis à jour du {{ current_establishment.lastSyncAt|date('d/m/Y à H:i') }}{% endif %}
				</p>
			</div>
		</div>

		<div class="row g-3 mb-4">
			<div class="col-12 col-md-6 col-xl-3">
				<div class="rr-hero h-100">
					<p class="rr-stat-label mb-2">Note moyenne</p>
					<p class="rr-hero-score mb-1">{{ stats.average ? stats.average|number_format(1, ',') : '—' }}</p>
					{% if stats.average %}
						<p class="rr-hero-stars mb-1" aria-hidden="true">{% for i in 1..5 %}{{ i <= stats.average|round ? '★' : '☆' }}{% endfor %}</p>
					{% endif %}
					<p class="rr-hero-sub mb-0">sur {{ stats.total }} avis</p>
				</div>
			</div>
			<div class="col-12 col-md-6 col-xl-3">
				<a href="{{ path('inbox') }}" class="rr-card h-100 d-block">
					<p class="rr-stat-label mb-2">Sans réponse</p>
					<p class="rr-stat-val {{ stats.unanswered > 0 ? 'rr-yellow' : 'rr-green' }}">{{ stats.unanswered }}</p>
					<p class="rr-stat-trend rr-muted mb-0">{{ stats.unanswered > 0 ? 'Répondre maintenant →' : 'Tout est à jour' }}</p>
				</a>
			</div>
			<div class="col-6 col-xl-3">
				<div class="rr-card h-100">
					<p class="rr-stat-label mb-2">Taux de réponse</p>
					<p class="rr-stat-val">{{ stats.responseRate }} %</p>
					<p class="rr-stat-trend rr-muted mb-0">des avis ont une réponse</p>
				</div>
			</div>
			<div class="col-6 col-xl-3">
				<div class="rr-card h-100">
					<p class="rr-stat-label mb-2">Avis négatifs</p>
					<p class="rr-stat-val rr-red">{{ stats.negativeRate }} %</p>
					<p class="rr-stat-trend rr-muted mb-0">notes de 1 et 2 étoiles</p>
				</div>
			</div>
		</div>

		<div class="row g-3 mb-4">
			<div class="col-12 col-lg-7">
				<section class="rr-card rr-card-lg h-100" aria-labelledby="curve-title">
					<h2 class="rr-section-title" id="curve-title">Évolution de la note moyenne</h2>
					{% if stats.curve|default([])|length > 1 %}
						<canvas id="ratingChart" height="140" role="img" aria-label="Note moyenne par mois"></canvas>
					{% else %}
						<p class="rr-empty">La courbe apparaîtra après deux mois d'avis.</p>
					{% endif %}
				</section>
			</div>
			<div class="col-12 col-lg-5">
				<section class="rr-card rr-card-lg h-100" aria-labelledby="split-title">
					<h2 class="rr-section-title" id="split-title">Répartition des notes</h2>
					{% for star in 5..1 %}
						{% set count = stats.repartition[star]|default(0) %}
						{% set pct = stats.total > 0 ? (count / stats.total * 100)|round : 0 %}
						<div class="rr-prog">
							<span class="rr-prog-label">{{ star }}★</span>
							<div class="rr-prog-track"><div class="rr-prog-fill rr-prog-fill-{{ star >= 4 ? 'pos' : (star == 3 ? 'mid' : 'neg') }}" data-width="{{ pct }}"></div></div>
							<span class="rr-prog-pct">{{ count }}</span>
						</div>
					{% endfor %}
				</section>
			</div>
		</div>

		<section class="rr-card rr-card-lg" aria-labelledby="latest-title">
			<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
				<h2 class="rr-section-title mb-0" id="latest-title">Derniers avis</h2>
				<a href="{{ path('reviews_list', {id: current_establishment.id}) }}" class="rr-btn rr-btn-secondary rr-btn-sm">Voir tous les avis</a>
			</div>
			{% for review in reviews %}
				{% set bucket = review.rating <= 2 ? 'neg' : (review.rating == 3 ? 'mid' : 'pos') %}
				<a href="{{ path('reviews_list', {id: current_establishment.id}) }}#review-{{ review.id }}" class="rr-latest">
					<span class="rr-rating rr-rating-{{ bucket }}">★ {{ review.rating }}/5</span>
					<span class="rr-latest-body">
						<span class="rr-review-author">{{ review.googleAuthor }}</span>
						<span class="rr-latest-text">{{ review.text ?: 'Note laissée sans commentaire.' }}</span>
					</span>
					<span class="rr-review-meta">{{ review.publishedAt|date('d/m/Y') }}</span>
					{% if review.ownerReply is null %}<span class="rr-pill rr-pill-yellow">Sans réponse</span>{% endif %}
				</a>
			{% else %}
				<p class="rr-empty">Aucun avis pour le moment. Lancez une synchronisation pour récupérer vos avis Google.</p>
			{% endfor %}
		</section>
	{% endif %}
{% endblock %}

{% block javascripts %}
	<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
	<script src="{{ asset('js/dashboard.js') }}"></script>
{% endblock %}
