{% extends 'base.html.twig' %}

{% block title %}À traiter — MonAvisPro{% endblock %}
{% block page_title %}À traiter{% endblock %}

{% block body %}
	<div class="rr-inbox-head">
		<div>
			<h1 class="rr-page-title" data-role="inbox-title" data-total="{{ total }}">
				{% if total > 0 %}{{ total }} avis attend{{ total > 1 ? 'ent' }} une réponse{% else %}Tout est à jour{% endif %}
			</h1>
			<p class="rr-page-sub">Les plus mauvaises notes d'abord. Un avis sans texte peut simplement être ignoré.</p>
		</div>
	</div>

	{% if reviews is empty %}
		<div class="rr-card rr-card-lg rr-empty-state">
			<div class="rr-empty-icon" aria-hidden="true">✓</div>
			<h2 class="rr-empty-title">Aucun avis en attente</h2>
			<p class="rr-empty-text">
				{% if establishments is empty %}
					Ajoutez votre premier établissement pour retrouver ici les avis auxquels répondre.
				{% else %}
					Les nouveaux avis arrivent automatiquement toutes les 6 heures.
				{% endif %}
			</p>
			{% if establishments is empty %}
				<a href="{{ path('establishment_new') }}" class="rr-btn rr-btn-primary rr-btn-lg mt-4">Ajouter un établissement</a>
			{% endif %}
		</div>
	{% else %}
		<div class="rr-inbox-toolbar">
			<div class="rr-chips" role="group" aria-label="Filtrer par note">
				<button type="button" class="rr-chip" data-filter="all" aria-pressed="true">Tous · <span data-count="all">{{ counts.all }}</span></button>
				<button type="button" class="rr-chip" data-filter="neg" aria-pressed="false">Négatifs (1–2★) · <span data-count="neg">{{ counts.neg }}</span></button>
				<button type="button" class="rr-chip" data-filter="mid" aria-pressed="false">Moyens (3★) · <span data-count="mid">{{ counts.mid }}</span></button>
				<button type="button" class="rr-chip" data-filter="pos" aria-pressed="false">Positifs (4–5★) · <span data-count="pos">{{ counts.pos }}</span></button>
			</div>
			{% if establishments|length > 1 %}
				<label class="rr-select-wrap">Établissement
					<select class="rr-select" data-role="establishment-filter">
						<option value="">Tous</option>
						{% for establishment in establishments %}
							<option value="{{ establishment.id }}">{{ establishment.name }}</option>
						{% endfor %}
					</select>
				</label>
			{% endif %}
		</div>

		<div data-role="inbox-feedback" aria-live="polite"></div>

		<div data-role="inbox-list">
			{% for review in reviews %}
				{% if previous_limit and loop.index == previous_limit + 1 %}<span id="suite" tabindex="-1"></span>{% endif %}
				{% include 'partials/_review_card.html.twig' with {review: review, show_establishment: establishments|length > 1, can_ignore: true} only %}
			{% endfor %}
		</div>

		<p class="rr-empty" data-role="filter-empty" hidden>Aucun avis pour ce filtre.</p>

		{% if total > shown %}
			{% set percent = (shown / total * 100)|round %}
			<div class="rr-load-more">
				<p class="rr-load-more-count"><span data-role="shown-count">{{ shown }}</span> avis affichés sur <span data-role="total-count">{{ total }}</span></p>
				<div class="rr-progress" role="progressbar" aria-label="Avis affichés" aria-valuemin="0" aria-valuemax="{{ total }}" aria-valuenow="{{ shown }}">
					<div class="rr-progress-bar" style="width: {{ percent }}%"></div>
				</div>
				{% if shown < 1000 %}
					<a class="rr-btn rr-btn-secondary" href="{{ path('inbox', {afficher: next_limit}) }}#suite">Afficher {{ min(step, total - shown) }} avis de plus</a>
				{% else %}
					<p class="rr-hint">Répondez à ces avis pour faire apparaître les suivants.</p>
				{% endif %}
			</div>
		{% endif %}
	{% endif %}
{% endblock %}

{% block javascripts %}
	<script src="{{ asset('js/review-reply.js') }}"></script>
	<script src="{{ asset('js/inbox.js') }}"></script>
{% endblock %}
