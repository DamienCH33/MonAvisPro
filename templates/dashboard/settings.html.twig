{% extends 'base.html.twig' %}

{% block title %}Réglages — {{ current_establishment.name }}{% endblock %}
{% block page_title %}Réglages{% endblock %}

{% set e = current_establishment %}

{% block body %}
	<div class="rr-inbox-head">
		<div>
			<h1 class="rr-page-title">Réglages</h1>
			<p class="rr-page-sub">{{ e.name }}</p>
		</div>
	</div>

	<div class="rr-tabs" role="tablist" aria-label="Sections des réglages">
		<button type="button" class="rr-tab" role="tab" id="tab-reponses" aria-controls="panel-reponses" aria-selected="true">Réponses</button>
		<button type="button" class="rr-tab" role="tab" id="tab-etablissement" aria-controls="panel-etablissement" aria-selected="false" tabindex="-1">Établissement</button>
		<button type="button" class="rr-tab" role="tab" id="tab-notifications" aria-controls="panel-notifications" aria-selected="false" tabindex="-1">Notifications</button>
	</div>

	<p class="rr-flash" data-role="settings-flash" role="status" hidden></p>

	{# ── Réponses ── #}
	<section role="tabpanel" id="panel-reponses" aria-labelledby="tab-reponses" class="rr-settings-panel">
		<form class="rr-card rr-card-lg" data-settings-form="reply">
			<h2 class="rr-section-title">Comment l'IA rédige vos réponses</h2>
			<p class="rr-hint mt-0 mb-4">Ces réglages s'appliquent à chaque proposition. Vous relisez toujours la réponse avant de la publier.</p>

			<fieldset class="mb-4">
				<legend class="rr-label">Adresse au client</legend>
				<div class="rr-segmented">
					<input type="radio" id="formality-vous" name="replyFormality" value="vous" {{ e.replyFormality == 'vous' ? 'checked' }}>
					<label for="formality-vous">Vouvoiement</label>
					<input type="radio" id="formality-tu" name="replyFormality" value="tu" {{ e.replyFormality == 'tu' ? 'checked' }}>
					<label for="formality-tu">Tutoiement</label>
				</div>
			</fieldset>

			<fieldset class="mb-4">
				<legend class="rr-label">Ton par défaut</legend>
				<div class="rr-segmented">
					{% for value, label in {cordial: 'Cordial', formel: 'Formel', empathique: 'Empathique'} %}
						<input type="radio" id="tone-{{ value }}" name="replyTone" value="{{ value }}" {{ e.replyTone == value ? 'checked' }}>
						<label for="tone-{{ value }}">{{ label }}</label>
					{% endfor %}
				</div>
				<p class="rr-hint">Modifiable avis par avis au moment de répondre.</p>
			</fieldset>

			<div class="mb-4 rr-field-narrow">
				<label class="rr-label" for="reply-signature">Signature</label>
				<input type="text" class="rr-input" id="reply-signature" name="replySignature" maxlength="120" placeholder="L'équipe de {{ e.name }}" value="{{ e.replySignature }}">
			</div>

			<div class="mb-4">
				<label class="rr-label" for="reply-instructions">Consignes pour ce commerce</label>
				<textarea class="rr-textarea" id="reply-instructions" name="replyInstructions" rows="4" maxlength="1000" placeholder="Ex. : signer avec le prénom du gérant, Paul. Rappeler que la boutique est fermée le lundi. Ne jamais parler des prix.">{{ e.replyInstructions }}</textarea>
				<p class="rr-hint">Ce que l'IA doit savoir, rappeler ou éviter. 1 000 caractères maximum.</p>
			</div>

			<button type="submit" class="rr-btn rr-btn-primary rr-btn-lg">Enregistrer</button>
		</form>
	</section>

	{# ── Établissement ── #}
	<section role="tabpanel" id="panel-etablissement" aria-labelledby="tab-etablissement" class="rr-settings-panel" hidden>
		<div class="rr-card rr-card-lg mb-3">
			<h2 class="rr-section-title">Fiche Google</h2>
			{% if e.connectedToGoogleBusiness %}
				<p class="mb-3"><span class="rr-pill rr-pill-green">Connectée</span> Les réponses sont publiées directement sur Google.</p>
			{% else %}
				<p class="mb-3"><span class="rr-pill rr-pill-yellow">Non connectée</span> Vos réponses sont enregistrées ici, mais pas publiées sur Google.</p>
				<a href="{{ path('google_business_connect') }}" class="rr-btn rr-btn-primary mb-3">Connecter ma fiche Google</a>
			{% endif %}
			<div class="d-flex flex-wrap align-items-center gap-3">
				<button type="button" class="rr-btn rr-btn-secondary" data-action="sync">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 11-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
					<span>Récupérer les nouveaux avis</span>
				</button>
				<span class="rr-review-meta">
					{{ e.lastSyncAt ? 'Dernière mise à jour le ' ~ e.lastSyncAt|date('d/m/Y à H:i') : 'Jamais synchronisé' }} · automatique toutes les 6 h
				</span>
			</div>
		</div>

		<form class="rr-card rr-card-lg mb-3" data-settings-form="info">
			<h2 class="rr-section-title">Informations</h2>
			<div class="row g-3 mb-4">
				<div class="col-12 col-md-6">
					<label class="rr-label" for="estab-name">Nom affiché</label>
					<input type="text" class="rr-input" id="estab-name" name="name" required maxlength="255" value="{{ e.name }}">
				</div>
				<div class="col-12 col-md-6">
					<label class="rr-label" for="estab-address">Adresse</label>
					<input type="text" class="rr-input" id="estab-address" name="address" maxlength="255" value="{{ e.address }}">
				</div>
			</div>
			<button type="submit" class="rr-btn rr-btn-primary">Enregistrer</button>
		</form>

		<div class="rr-danger-zone d-flex flex-wrap align-items-center justify-content-between gap-3">
			<div>
				<h2 class="rr-danger-zone-title mb-1">Supprimer cet établissement</h2>
				<p class="rr-review-meta mb-0">L'établissement et tous ses avis sont supprimés de MonAvisPro. Rien n'est supprimé sur Google.</p>
			</div>
			<button type="button" class="rr-btn rr-btn-danger" data-action="delete">Supprimer</button>
		</div>
	</section>

	{# ── Notifications ── #}
	<section role="tabpanel" id="panel-notifications" aria-labelledby="tab-notifications" class="rr-settings-panel" hidden>
		<div class="rr-card rr-card-lg mb-3">
			<h2 class="rr-section-title">Alerte avis négatif</h2>
			<div class="rr-toggle">
				<div>
					<p class="rr-toggle-name mb-0" id="alerts-label">Prévenez-moi par e-mail</p>
					<p class="rr-toggle-desc mb-0">Dès qu'un avis de 1 ou 2 étoiles arrive, à {{ app.user.email }}.</p>
				</div>
				<button type="button" role="switch" aria-labelledby="alerts-label" aria-checked="{{ e.alertsEnabled ? 'true' : 'false' }}"
				        class="rr-switch {{ e.alertsEnabled ? 'rr-switch-on' : 'rr-switch-off' }}" data-action="toggle-alerts"></button>
			</div>
		</div>

		<form class="rr-card rr-card-lg" data-settings-form="report">
			<h2 class="rr-section-title">Bilan mensuel</h2>
			<p class="rr-hint mt-0 mb-3">Le 1er de chaque mois, un e-mail résume les avis du mois : note, nombre d'avis, réponses. Pratique si vous gérez les avis pour un client.</p>
			<div class="mb-4 rr-field-narrow">
				<label class="rr-label" for="client-email">Envoyer le bilan à</label>
				<input type="email" class="rr-input" id="client-email" name="clientEmail" maxlength="180" placeholder="contact@commerce.fr" value="{{ e.clientEmail }}">
				<p class="rr-hint">Laissez vide pour ne rien envoyer.</p>
			</div>
			<button type="submit" class="rr-btn rr-btn-primary">Enregistrer</button>
		</form>
	</section>
{% endblock %}

{% block javascripts %}
	<script src="{{ asset('js/settings.js') }}"></script>
{% endblock %}
