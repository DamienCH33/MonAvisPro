{# templates/legal/privacy.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Politique de confidentialité · Mon Avis Pro
{% endblock %}
{% block page_title %}Confidentialité
{% endblock %}

{% block body %}
	<div class="rr-legal">

		<a href="{{ app.user ? path('app_dashboard') : path('app_home') }}" class="rr-legal-back">
			Retour
		</a>

		<div class="rr-legal-hero">

			<h1>Politique de confidentialité</h1>

			<p>
				Gestion, stockage et protection des données personnelles utilisées par MonAvisPro.
			</p>

			<div class="rr-legal-meta">
				Dernière mise à jour :
				{{ "now"|date("d/m/Y") }}
			</div>
		</div>

		<div class="rr-legal-content">

			<section class="rr-legal-card">
				<h2>1. Éditeur du service</h2>

				<p>
					MonAvisPro est édité par Damien Chauveau dans le cadre d’un projet
										                personnel de développement logiciel.
				</p>

				<p>
					Contact :
					<a href="mailto:contact@monavispro.fr">contact@monavispro.fr</a>
				</p>
			</section>

			<section class="rr-legal-card">
				<h2>2. Données collectées</h2>

				<ul>
					<li>Adresse e-mail</li>
					<li>Mot de passe chiffré</li>
					<li>Données Google Business Profile</li>
					<li>Données techniques de connexion</li>
				</ul>
			</section>

			<section class="rr-legal-card">
				<h2>3. Finalités du traitement</h2>

				<ul>
					<li>Gestion du compte utilisateur</li>
					<li>Centralisation des avis Google</li>
					<li>Analyse IA des avis</li>
					<li>Sécurité et journalisation</li>
				</ul>
			</section>

			<section class="rr-legal-card">
				<h2>4. Base légale</h2>

				<ul>
					<li>Exécution du contrat</li>
					<li>Consentement utilisateur</li>
					<li>Intérêt légitime de sécurité</li>
				</ul>
			</section>

			<section class="rr-legal-card">
				<h2>5. Partage avec des tiers</h2>

				<ul>
					<li>Google LLC</li>
					<li>OpenAI</li>
					<li>Railway Corp.</li>
				</ul>
			</section>

			<section class="rr-legal-card">
				<h2>6. Durée de conservation</h2>

				<ul>
					<li>Compte : jusqu’à suppression</li>
					<li>Avis synchronisés : 90 jours maximum</li>
					<li>Logs techniques : 30 jours</li>
				</ul>
			</section>

			<section class="rr-legal-card">
				<h2>7. Sécurité</h2>

				<ul>
					<li>Mots de passe chiffrés</li>
					<li>HTTPS/TLS</li>
					<li>Accès serveur restreint</li>
					<li>Tokens OAuth protégés</li>
				</ul>
			</section>

			<section class="rr-legal-card">
				<h2>8. Vos droits</h2>

				<p>
					Vous disposez des droits d’accès, de rectification, d’effacement,
										                d’opposition et de portabilité prévus par le RGPD.
				</p>
			</section>

			<section class="rr-legal-card">
				<h2>9. Révocation Google</h2>

				<p>
					L’accès Google Business Profile peut être révoqué à tout moment.
				</p>
			</section>

			<section class="rr-legal-card">
				<h2>10. Cookies</h2>

				<p>
					MonAvisPro utilise uniquement des cookies nécessaires à l’authentification.
				</p>
			</section>

			<section class="rr-legal-card">
				<h2>11. Conformité Google API</h2>

				<p>
					MonAvisPro respecte la Google API Services User Data Policy.
				</p>
			</section>

			<section class="rr-legal-card">
				<h2>12. Réclamation CNIL</h2>

				<p>
					En cas de litige, une réclamation peut être déposée auprès de la CNIL.
				</p>
			</section>

		</div>
	</div>
{% endblock %}
