{% extends 'base.html.twig' %}
{% block title %}Connexion — MonAvisPro{% endblock %}

{% block public_nav %}
	<div class="d-flex align-items-center gap-3">
		{% if app_registration_enabled and not app_demo_mode %}
			<a href="{{ path('app_register') }}" class="rr-btn rr-btn-secondary">Créer un compte</a>
		{% endif %}
	</div>
{% endblock %}

{% block body %}
	<div class="rr-auth-wrapper">
		<div class="rr-auth-box">
			<h1 class="rr-auth-title text-center">Connexion</h1>
			<p class="rr-auth-sub text-center">Retrouvez vos avis et vos réponses.</p>

			{% if error %}
				<div class="rr-flash rr-flash-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
			{% endif %}

			<form method="post" action="{{ path('app_login') }}" class="rr-card rr-card-lg">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

				<div class="mb-3">
					<label class="rr-label" for="email">E-mail</label>
					<input class="rr-input" type="email" id="email" name="_username" value="{{ last_username }}" placeholder="vous@exemple.fr" autocomplete="email" required autofocus>
				</div>

				<div class="mb-3">
					<label class="rr-label" for="password">Mot de passe</label>
					<input class="rr-input" type="password" id="password" name="_password" autocomplete="current-password" required>
				</div>

				<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
					<label class="rr-check">
						<input type="checkbox" name="_remember_me">
						Rester connecté
					</label>
					<a href="{{ path('app_forgot_password_request') }}" class="rr-link">Mot de passe oublié ?</a>
				</div>

				<button type="submit" class="rr-btn rr-btn-primary rr-btn-full rr-btn-lg">Se connecter</button>
			</form>

			<p class="rr-hint text-center mt-4">
				Envie de voir avant de vous inscrire ?
				<a href="{{ path('demo_login') }}" class="rr-link">Essayer la démo</a>
			</p>
			{% if app_registration_enabled and not app_demo_mode %}
				<p class="rr-hint text-center mt-1">
					Pas encore de compte ?
					<a href="{{ path('app_register') }}" class="rr-link">Créer un compte</a>
				</p>
			{% endif %}
		</div>
	</div>
{% endblock %}
