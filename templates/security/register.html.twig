{% extends 'base.html.twig' %}
{% block title %}Créer un compte — MonAvisPro{% endblock %}

{% block public_nav %}
	<a href="{{ path('app_login') }}" class="rr-btn rr-btn-secondary">Connexion</a>
{% endblock %}

{% block body %}
	<div class="rr-auth-wrapper">
		<div class="rr-auth-box">
			<h1 class="rr-auth-title text-center">Créer un compte</h1>
			<p class="rr-auth-sub text-center">Gratuit, sans carte bancaire. Vous connectez votre fiche Google juste après.</p>

			{{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'class': 'rr-card rr-card-lg'}}) }}
			{{ form_errors(registrationForm) }}

			<div class="mb-3">
				{{ form_label(registrationForm.email, 'E-mail', {'label_attr': {'class': 'rr-label'}}) }}
				{{ form_widget(registrationForm.email, {'attr': {'class': 'rr-input', 'placeholder': 'vous@exemple.fr', 'autocomplete': 'email'}}) }}
				{% if form_errors(registrationForm.email) %}
					<div class="rr-error">{{ form_errors(registrationForm.email) }}</div>
				{% endif %}
			</div>

			<div class="mb-3">
				{{ form_label(registrationForm.plainPassword.first, 'Mot de passe', {'label_attr': {'class': 'rr-label'}}) }}
				{{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'rr-input', 'autocomplete': 'new-password', 'aria-describedby': 'pwd-hint'}}) }}
				<p class="rr-hint" id="pwd-hint">8 caractères minimum.</p>
				{% if form_errors(registrationForm.plainPassword.first) %}
					<div class="rr-error">{{ form_errors(registrationForm.plainPassword.first) }}</div>
				{% endif %}
			</div>

			<div class="mb-4">
				{{ form_label(registrationForm.plainPassword.second, 'Confirmer le mot de passe', {'label_attr': {'class': 'rr-label'}}) }}
				{{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'rr-input', 'autocomplete': 'new-password'}}) }}
				{% if form_errors(registrationForm.plainPassword.second) %}
					<div class="rr-error">{{ form_errors(registrationForm.plainPassword.second) }}</div>
				{% endif %}
			</div>

			<div class="mb-4">
				<label class="rr-check">
					{{ form_widget(registrationForm.agreeTerms) }}
					<span>J'accepte les <a href="{{ path('app_cgu') }}" class="rr-link">CGU</a> et la <a href="{{ path('app_privacy') }}" class="rr-link">politique de confidentialité</a></span>
				</label>
				{% if form_errors(registrationForm.agreeTerms) %}
					<div class="rr-error">{{ form_errors(registrationForm.agreeTerms) }}</div>
				{% endif %}
			</div>

			<button type="submit" class="rr-btn rr-btn-primary rr-btn-full rr-btn-lg">Créer mon compte</button>
			{{ form_end(registrationForm) }}

			<p class="rr-hint text-center mt-4">
				Déjà un compte ? <a href="{{ path('app_login') }}" class="rr-link">Se connecter</a>
			</p>
		</div>
	</div>
{% endblock %}
