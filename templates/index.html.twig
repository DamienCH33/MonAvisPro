{% extends 'base.html.twig' %}

{% block title %}MonAvisPro — Répondez à vos avis Google en quelques secondes{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&display=swap">
	<link rel="stylesheet" href="{{ asset('css/landing.css') }}">
{% endblock %}

{% set can_register = app_registration_enabled and not app_demo_mode %}

{% block public_nav %}
	<nav class="lp-nav" aria-label="Compte">
		<a href="{{ path('app_login') }}" class="lp-btn lp-btn-ghost">Connexion</a>
		{% if app_registration_enabled and not app_demo_mode %}
			<a href="{{ path('app_register') }}" class="lp-btn lp-btn-main">Créer un compte</a>
		{% endif %}
	</nav>
{% endblock %}

{% block body %}
<div class="lp">

	{# ───────────── Haut de page : l'instant où l'avis tombe ───────────── #}
	<section class="lp-hero">
		<div class="lp-wrap lp-hero-grid">
			<div class="lp-hero-copy">
				<h1 class="lp-h1">Un client vient de laisser une étoile. Votre réponse est déjà prête.</h1>
				<p class="lp-lead">
					MonAvisPro reçoit vos avis Google, vous prévient quand un client est mécontent et rédige une réponse dans le ton de votre commerce. Vous relisez, vous publiez&nbsp;: trente secondes au lieu d'une soirée.
				</p>
				<div class="lp-actions">
					{% if can_register %}
						<a href="{{ path('app_register') }}" class="lp-btn lp-btn-main">Créer mon compte gratuit</a>
						<a href="{{ path('demo_login') }}" class="lp-btn lp-btn-ghost">Essayer la démo</a>
					{% else %}
						<a href="{{ path('demo_login') }}" class="lp-btn lp-btn-main">Essayer la démo</a>
						<a href="mailto:contact@monavispro.fr?subject=MonAvisPro%20pour%20mon%20commerce" class="lp-btn lp-btn-ghost">Demander un accès</a>
					{% endif %}
				</div>
				<p class="lp-note">La démo s'ouvre sans inscription, sur deux commerces fictifs. Rien n'est publié sur Google.</p>
			</div>

			<div class="lp-stage" aria-hidden="true" data-role="stage">
				<div class="lp-phone">
					<div class="lp-phone-bar">
						<span class="lp-phone-title">À traiter</span>
						<span class="lp-phone-count" data-role="count">3</span>
					</div>

					<div class="lp-notif" data-step="notif">
						<span class="lp-notif-dot"></span>
						Nouvel avis · Boulangerie du Coin
					</div>

					<article class="lp-card" data-step="review">
						<div class="lp-card-head">
							<span class="lp-stars lp-stars-low">★<span>★★★★</span></span>
							<strong>François M.</strong>
							<span class="lp-muted">à l'instant</span>
						</div>
						<p class="lp-card-text">Plus de 45 minutes pour récupérer une commande réservée depuis deux semaines. Personne ne nous a prévenus. Décevant.</p>

						<div class="lp-reply" data-step="reply">
							<p class="lp-reply-label" data-role="reply-label">Rédaction de la réponse…</p>
							<p class="lp-reply-text"><span data-role="typed"></span><span class="lp-caret"></span></p>
							<div class="lp-reply-actions">
								<span class="lp-fake-btn" data-role="publish">Publier sur Google</span>
								<span class="lp-fake-btn lp-fake-ghost">Modifier</span>
							</div>
						</div>
					</article>

					<div class="lp-toast" data-step="toast">Réponse publiée sur Google</div>
				</div>
			</div>
		</div>
	</section>

	{# ───────────── Même avis, trois tons (interactif) ───────────── #}
	<section class="lp-section" aria-labelledby="tones-title">
		<div class="lp-wrap lp-tones">
			<div class="lp-tones-intro">
				<h2 class="lp-h2" id="tones-title">Pas une réponse type. La vôtre.</h2>
				<p class="lp-text">Vous choisissez le vouvoiement ou le tutoiement, le ton, la signature, et les consignes à respecter. Essayez sur le même avis&nbsp;:</p>
				<div class="lp-tone-picker" role="tablist" aria-label="Ton de la réponse">
					<button type="button" role="tab" class="lp-tone" aria-selected="true" aria-controls="tone-panel" data-tone="cordial">Cordial</button>
					<button type="button" role="tab" class="lp-tone" aria-selected="false" aria-controls="tone-panel" data-tone="formel" tabindex="-1">Formel</button>
					<button type="button" role="tab" class="lp-tone" aria-selected="false" aria-controls="tone-panel" data-tone="empathique" tabindex="-1">Empathique</button>
				</div>
			</div>

			<div class="lp-tone-demo">
				<div class="lp-quote">
					<span class="lp-stars lp-stars-mid">★★★<span>★★</span></span>
					<p>Le pain est bon, mais le dimanche matin l'accueil manque de sourire.</p>
					<span class="lp-muted">Valérie S. · Boulangerie du Coin</span>
				</div>
				<div class="lp-answer" id="tone-panel" role="tabpanel" aria-live="polite">
					<p data-tone-text="cordial">Bonjour Valérie, merci pour votre retour et ravis que notre pain vous plaise ! Nous avons bien noté pour le dimanche matin : toute l'équipe va y veiller. À très vite.<br>L'équipe de la Boulangerie du Coin</p>
					<p data-tone-text="formel" hidden>Madame, nous vous remercions de votre avis. Nous avons transmis votre remarque concernant l'accueil du dimanche matin à l'ensemble de notre équipe afin d'y remédier. Nous espérons avoir le plaisir de vous accueillir à nouveau.<br>La direction de la Boulangerie du Coin</p>
					<p data-tone-text="empathique" hidden>Bonjour Valérie, merci d'avoir pris le temps d'écrire. Un accueil sans sourire, ce n'est pas ce que nous voulons pour vous, surtout un dimanche. Nous en avons parlé en équipe et nous serons ravis de vous le prouver lors de votre prochaine visite.<br>L'équipe de la Boulangerie du Coin</p>
				</div>
			</div>
		</div>
	</section>

	{# ───────────── Les trois étapes (vraie séquence) ───────────── #}
	<section class="lp-section" aria-labelledby="how-title">
		<div class="lp-wrap">
			<h2 class="lp-h2" id="how-title">En place en deux minutes</h2>
			<ol class="lp-steps">
				<li>
					<span class="lp-step-n">1</span>
					<h3 class="lp-h3">Connectez votre fiche Google</h3>
					<p class="lp-text">Avec votre compte Google, en quelques clics. Aucun mot de passe transmis, accès retirable à tout moment.</p>
				</li>
				<li>
					<span class="lp-step-n">2</span>
					<h3 class="lp-h3">Vos avis arrivent seuls</h3>
					<p class="lp-text">Toutes les six heures, triés par urgence. Un e-mail vous prévient dès qu'un avis d'une ou deux étoiles tombe.</p>
				</li>
				<li>
					<span class="lp-step-n">3</span>
					<h3 class="lp-h3">Vous relisez, vous publiez</h3>
					<p class="lp-text">La réponse est rédigée. Vous la gardez, la modifiez ou l'écrivez vous-même. Rien ne part sans votre clic.</p>
				</li>
			</ol>
		</div>
	</section>

	{# ───────────── Pour qui ───────────── #}
	<section class="lp-section" aria-labelledby="who-title">
		<div class="lp-wrap lp-who">
			<h2 class="lp-h2" id="who-title">Fait pour ceux qui n'ont pas le temps</h2>
			<div class="lp-who-grid">
				<div>
					<h3 class="lp-h3">Vous tenez un commerce</h3>
					<p class="lp-text">Boulangerie, salon, restaurant, garage, cabinet : vos clients lisent les avis avant de pousser la porte. Répondre à chacun montre que quelqu'un écoute, sans y laisser vos soirées.</p>
				</div>
				<div>
					<h3 class="lp-h3">Vous gérez plusieurs adresses</h3>
					<p class="lp-text">Tous les avis de toutes vos boutiques dans une seule liste. Chaque commerce garde sa signature et ses consignes, et le 1er du mois un bilan part par e-mail.</p>
				</div>
				<div>
					<h3 class="lp-h3">Vous le faites pour vos clients</h3>
					<p class="lp-text">Agence ou indépendant, vous répondez pour le compte de commerçants. Le bilan mensuel leur montre ce qui a été fait, sans tableau à remplir.</p>
				</div>
			</div>
		</div>
	</section>

	{# ───────────── Questions ───────────── #}
	<section class="lp-section" aria-labelledby="faq-title">
		<div class="lp-wrap lp-faq">
			<h2 class="lp-h2" id="faq-title">Les questions qu'on nous pose</h2>
			<details>
				<summary>L'IA publie-t-elle des réponses sans moi ?</summary>
				<p class="lp-text">Non. Chaque réponse est une proposition. Elle part sur Google uniquement quand vous cliquez sur « Publier ».</p>
			</details>
			<details>
				<summary>Que voit MonAvisPro de mon compte Google ?</summary>
				<p class="lp-text">Les fiches d'établissement que vous choisissez et leurs avis, rien d'autre. La connexion passe par la page officielle de Google et se retire en un clic depuis votre compte.</p>
			</details>
			<details>
				<summary>Je n'ai pas encore de fiche Google.</summary>
				<p class="lp-text">Créez-la gratuitement sur Google Business Profile. Une fois validée par Google, vous la connectez ici en deux minutes.</p>
			</details>
			<details>
				<summary>Et si la réponse proposée ne me plaît pas ?</summary>
				<p class="lp-text">Changez de ton en un clic, demandez un autre texte, ou écrivez la réponse vous-même dans la même case.</p>
			</details>
		</div>
	</section>

	{# ───────────── Fin ───────────── #}
	<section class="lp-end">
		<div class="lp-wrap">
			<p class="lp-end-stars" aria-hidden="true">★★★★★</p>
			<h2 class="lp-h2">Le prochain avis arrive peut-être ce soir.</h2>
			<div class="lp-actions lp-actions-center">
				{% if can_register %}
					<a href="{{ path('app_register') }}" class="lp-btn lp-btn-main">Créer mon compte gratuit</a>
				{% endif %}
				<a href="{{ path('demo_login') }}" class="lp-btn {{ can_register ? 'lp-btn-ghost' : 'lp-btn-main' }}">Essayer la démo</a>
			</div>
		</div>
	</section>
</div>
{% endblock %}

{% block javascripts %}
	<script src="{{ asset('js/landing.js') }}"></script>
{% endblock %}
